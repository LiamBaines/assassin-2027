# Copy to .env.local. Local values match `supabase start`; use `supabase status`
# to read the publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: base URL of the Spring API (no trailing slash). Never prefix
# with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8080
